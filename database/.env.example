# Copia este archivo como .env (desarrollo) y como .env.test (pruebas).
# En .env.test cambia la base por steply_test: las pruebas BORRAN sus datos.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/steply?schema=public"

# Cloudinary (evidencias). Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""
CLOUDINARY_CARPETA="steply/evidencias"

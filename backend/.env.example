PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/steply?schema=public"
JWT_SECRET="cambie-esto-por-una-clave-larga"

# Producción: origen del frontend, sin barra final. Varios orígenes se separan con coma.
# CORS_ORIGIN=https://app.ejemplo.com

# Cloudinary. Use las tres variables o, en su lugar, CLOUDINARY_URL.
# Sin estas variables, en desarrollo las fotos viven solo en memoria.
# En producción el servidor no arranca si faltan.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CARPETA=steply/evidencias

# Solo para fotos de perfil en desarrollo sin Cloudinary.
# PUBLIC_BASE_URL=http://localhost:3000

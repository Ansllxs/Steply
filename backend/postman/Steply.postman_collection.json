{
  "info": {
    "name": "Steply API",
    "description": "Endpoints del backend de Steply. Primero se corre \"Iniciar sesión\" (guarda el token solo). Las peticiones que crean algo guardan su id en las variables de la colección para usarlo en las siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "correo",
      "value": "angie@ejemplo.com"
    },
    {
      "key": "password",
      "value": "Steply123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "amistadId",
      "value": ""
    },
    {
      "key": "grupoId",
      "value": ""
    },
    {
      "key": "codigoInvitacion",
      "value": "COMPU-SQUAD-DEMO"
    },
    {
      "key": "retoId",
      "value": ""
    },
    {
      "key": "registroId",
      "value": ""
    },
    {
      "key": "castigoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "Servidor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Base de datos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/salud-bd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud-bd"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Cambie las variables correo y password para entrar con otro usuario del seed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrarse",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario de prueba\",\n  \"correo\": \"{{$randomEmail}}\",\n  \"password\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Mi sesión",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cambiar-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cambiar-password"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actual\": \"Steply123!\",\n  \"nueva\": \"Steply123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
